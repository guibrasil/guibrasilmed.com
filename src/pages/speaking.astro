---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`Speaking | ${config.site.title}`}
  description="Gui Medeiros's talks and appearances."
>
  <Header />
  <Breadcrumb />

  <main id="main-content" class="app-layout pb-12">
    <h1 class="text-2xl font-semibold sm:text-3xl mt-8 mb-4">Speaking</h1>

    <p class="text-muted-foreground italic">
      No talks yet — but this page will be here when they happen.
      <!-- TODO: Gui — add talks here: title, event, date, link to slides/recording -->
    </p>
  </main>

  <Footer />
</Layout>

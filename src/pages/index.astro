---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const recentArticles = allArticles
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Gui Medeiros">
  <section class="intro">
    <h1 class="intro-name">Guilherme Medeiros</h1>
    <p class="intro-role">Mobile Developer · London, UK</p>
    <p class="intro-contact">
      <a href="mailto:gui.br.med@gmail.com">gui.br.med@gmail.com</a>
      <span class="intro-sep">·</span>
      <a href="https://linkedin.com/in/guibrasilmed" target="_blank" rel="noopener">LinkedIn</a>
      <span class="intro-sep">·</span>
      <a href="https://github.com/guibrasil" target="_blank" rel="noopener">GitHub</a>
    </p>
    <p class="intro-desc">Building iOS banking products for financial institutions worldwide. Focused on clean architecture, test coverage, and shipping things that work.</p>
  </section>

  {recentArticles.length > 0 && (
    <section>
      <p class="section-label">recent articles</p>
      <ul class="article-list">
        {recentArticles.map(article => (
          <li class="article-list-item">
            <a href={`/articles/${article.id}`} class="article-list-link">
              <span class="article-list-arrow">→</span>
              <span class="article-list-title">{article.data.title}</span>
            </a>
            <div class="article-list-meta">
              <time class="article-list-date" datetime={article.data.date.toISOString()}>
                {article.data.date.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}
              </time>
              {article.data.tags.length > 0 && (
                <span class="article-list-tags">
                  {article.data.tags.map(tag => <span class="tag">#{tag}</span>)}
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>
      <a href="/articles" class="view-all">all articles →</a>
    </section>
  )}
</BaseLayout>

<style>
  .intro-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 4px;
    font-family: var(--font-mono);
  }

  .intro-role {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    margin: 0 0 10px;
  }

  .intro-contact {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0 0 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
  }

  .intro-contact a {
    color: var(--muted);
  }

  .intro-contact a:hover {
    color: var(--accent);
  }

  .intro-sep {
    margin: 0 8px;
    color: var(--border);
  }

  .intro-desc {
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0;
    color: var(--text);
  }
</style>
